# ============================================================
# MEDIMESH INDIA 2.0 — Environment Configuration
# ============================================================
# Copy this file to .env.local for development.
# Never commit .env.local or real secrets to source control.
# ============================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MEDIMESH INDIA"

# Database (PostgreSQL — introduced in a later phase)
# DATABASE_URL=postgresql://user:password@localhost:5432/medimesh

# Authentication (Auth.js — introduced in a later phase)
# AUTH_SECRET=generate-a-secure-random-string-here
# AUTH_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_DEMO_MODE=true
